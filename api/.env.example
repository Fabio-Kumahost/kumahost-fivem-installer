# KumaHost FiveM API — environment configuration
# Copy to .env and adjust. NEVER commit the real .env file.

# HTTP
PORT=8787
HOST=127.0.0.1
# Comma-separated list of allowed panel origins for CORS.
CORS_ORIGIN=http://localhost:8787

# Security — generate strong random values (e.g. `openssl rand -hex 48`).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h
# bcrypt work factor (10–12 is a good production range).
BCRYPT_ROUNDS=12

# Database (SQLite file path).
DB_PATH=./data/kumahost.db

# Path to the installer entrypoint used to control the server.
INSTALLER_PATH=/opt/kumahost/installer/install.sh
# Prefix used to run privileged installer commands (configured via sudoers).
PRIVILEGE_PREFIX=sudo

# FiveM service + paths (must match the installer configuration).
FIVEM_SERVICE=fivem
FIVEM_BASE=/opt/fivem
FIVEM_LOG=/var/log/fivem/server.log
TXADMIN_PORT=40120

# Rate limiting.
RATE_WINDOW_MS=900000
RATE_MAX=300
AUTH_RATE_MAX=10

# Set to "true" only behind HTTPS so cookies get the Secure flag.
SECURE_COOKIES=false
